Options -Indexes
ServerSignature Off

# Deny direct access to sensitive files
<FilesMatch "^(config\.php|auth\.php|\.env|composer\.(json|lock)|package(-lock)?\.json)$">
    Require all denied
</FilesMatch>

# Deny hidden files/folders (except well-known for certificates)
RewriteEngine On
RewriteRule "(^|/)\.(?!well-known/)" - [F]

# Security headers (defense in depth; app also sets headers in PHP)
<IfModule mod_headers.c>
    Header always set X-Frame-Options "SAMEORIGIN"
    Header always set X-Content-Type-Options "nosniff"
    Header always set Referrer-Policy "same-origin"
    Header always set Permissions-Policy "camera=(self), microphone=(), geolocation=()"
</IfModule>

# Optional HTTPS redirect (enable only when SSL is configured on this host)
# RewriteCond %{HTTPS} !=on
# RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]
